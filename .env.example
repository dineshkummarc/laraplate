APP_NAME="Laraplate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=127.0.0.1,::1
APP_PORT=8000
APP_LOGO="https://raw.githubusercontent.com/getlaraplate/brand/master/logos/blueprint/laraplate.svg"
APP_FAVICON="https://raw.githubusercontent.com/getlaraplate/brand/master/logos/blueprint/laraplate.svg"

# FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# APP_EDITOR=VSCode

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_DAILY_DAYS=2

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=sessions

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Per-minute rate limit for the embeddings job queue; raise for faster bulk backfills.
EMBEDDINGS_QUEUE_RATE_PER_MINUTE=10
# Optimistic batch size for bulk (scout:import) reindexing; the adaptive batcher shrinks it when the engine strains.
BULK_INDEX_BATCH=100

CACHE_STORE=redis
CACHE_PREFIX=laraplate
SCOUT_QUEUE=true
SCOUT_DRIVER=elasticsearch

HORIZON_MEMORY_LIMIT=1024

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=180

HORIZON_MEMORY_LIMIT=1024

# MAIL_MAILER=log
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false


# ELASTIC_HOST=localhost:9200

# OPENAI_API_KEY=

# Core Module
SEARCH_ENGINE=elasticsearch
SEARCH_DATABASE_PG_TRGM_ENABLED=false
FORCE_HTTPS=false

# AI Module — documentation RAG
# AI_FAQ_ES_INDEX=laraplate_rag_docs
# The RAG vector length is the active embedding profile's `dimensions` (no env var).

# AI Module, servers for embeddings, reranking and transcription (Modules/AI/docs/STANDARD_SERVERS_INSTALLATION.md)
# Root URL of the default embeddings server, without /v1 (Text Embeddings Inference, Infinity, Ollama, LocalAI).
# AI_EMBEDDINGS_URL=
# AI_EMBEDDINGS_API_KEY=
# Seconds an embeddings request may take; a CPU-bound server is slow.
# AI_EMBEDDINGS_TIMEOUT=30
# Documents per embeddings request; TEI refuses more than its --max-client-batch-size (32 by default).
# AI_EMBEDDINGS_BATCH_SIZE=32
# Server of the profiles that name it, when it is another process than the default one (one TEI process per model).
# AI_EMBEDDINGS_MINILM_URL=
# AI_EMBEDDINGS_MINILM_API_KEY=
# Reranker server and its dialect: tei (POST /rerank) or cohere (Infinity, vLLM; needs AI_RERANK_MODEL).
# AI_RERANK_URL=
# AI_RERANK_API_KEY=
# AI_RERANK_DIALECT=tei
# AI_RERANK_MODEL=
# Transcription server (OpenAI-style POST /v1/audio/transcriptions); unset means no transcript.
# AI_TRANSCRIPTION_URL=
# AI_TRANSCRIPTION_API_KEY=
# AI_TRANSCRIPTION_TIMEOUT=120

# MES Module
